PORT=5055
MONGO_URI=mongodb://localhost:27017/hrms
JWT_SECRET=change-me-to-a-long-random-string
# Extra allowed frontend origins, comma-separated (the production Vercel URL is always allowed)
CORS_ORIGIN=
# Gemini key for the AI tools (optional; the AI buttons show a clear error without it)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Public demo: seeds a fictional company with one login per role.
# WARNING: wipes and reseeds the whole database on start and every 24h. Only use a dedicated demo database.
DEMO_MODE=false
# Timezone used to decide "today" for attendance
COMPANY_TIMEZONE=Asia/Kolkata
